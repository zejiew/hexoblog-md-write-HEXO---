{
  "name": "hexo-imgbed-writer",
  "version": "1.2.0",
  "description": "本地 Markdown 写作台：粘贴或拖入图片即自动上传到 CloudFlare-ImgBed，并把链接插回正文；直接读写 Hexo 文章目录，一键生成部署。",
  "main": "server.js",
  "bin": {
    "md-writer": "server.js"
  },
  "scripts": {
    "start": "node server.js --open",
    "dev": "node server.js --open",
    "test": "node test/fm-roundtrip.js && node test/dom-smoke.js"
  },
  "keywords": [
    "markdown",
    "editor",
    "markdown-editor",
    "hexo",
    "blog",
    "imagebed",
    "image-host",
    "cloudflare",
    "imgbed",
    "self-hosted"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "server.js",
    "public/",
    "config.json",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "private": false
}
